# 이 파일을 .env 로 복사해서 값을 채운다. (cp .env.example .env)
# 값은 모두 자리표시자이며 실제 비밀값은 .env 에만 둔다. .env 는 git 에 올리지 않는다.
# 줄 앞에 # 이 붙은 항목은 선택이며, 적힌 값이 기본값이다.

# ---------------------------------------------------------------
# 데이터베이스 (필수)
# ---------------------------------------------------------------
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# docker compose 의 MariaDB 컨테이너 root 비밀번호
DB_ROOT_PASSWORD=your_db_root_password
# gradlew bootRun 으로 직접 실행할 때만 사용
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=cabi

# 비어 있는 DB 에 스키마를 만들려면 true. 기본값은 false 이고, 이미 스키마가 있는 DB 는 건드리지 않는다.
FLYWAY_ENABLED=true

# ---------------------------------------------------------------
# Redis
# ---------------------------------------------------------------
# docker compose 가 호스트에 여는 Redis 포트 (필수)
REDIS_PORT=6379
# gradlew bootRun 으로 직접 실행할 때만 사용
# REDIS_HOST=127.0.0.1
# 비밀번호 없는 로컬 Redis 를 쓸 때만 true (prod 프로파일에서는 거부됨). docker compose 는 이미 true 로 둔다.
# REDIS_ALLOW_INSECURE=false

# ---------------------------------------------------------------
# 인증 (필수)
# ---------------------------------------------------------------
# 32바이트 이상의 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=your_jwt_secret_at_least_32_bytes_long
FT_CLIENT_ID=your_42_client_id
FT_CLIENT_SECRET=your_42_client_secret
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---------------------------------------------------------------
# 서비스 주소 (필수)
# ---------------------------------------------------------------
# OAuth 로그인 후 돌아올 프론트 주소. https 이거나 localhost 만 허용하고, 끝에 / 를 붙이지 않는다.
FRONTEND_URL=http://localhost
# docker compose 가 컨테이너로 넘기는 값. 현재 앱은 이 이름을 읽지 않는다. (아래 APP_AUTH_COOKIE_SECURE 참고)
COOKIE_SECURE=false
# 쉼표로 구분한 추가 CORS 허용 origin. FRONTEND_URL 의 origin 은 자동으로 허용된다.
# CORS_ALLOWED_ORIGINS=
# https 에서 쿠키에 Secure 속성을 붙이려면 true
# APP_AUTH_COOKIE_SECURE=false

# ---------------------------------------------------------------
# 외부 서비스 (필수)
# ---------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# 반납 사진을 올리는 Azure Blob Storage 연결 문자열
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=eW91cl9hY2NvdW50X2tleQ==;EndpointSuffix=core.windows.net"
# AI 청결도 검사 서버가 사용할 모델 파일 경로 (AI 서버 이미지 기준)
AI_MODEL_PATH=your_ai_model_path
# AI 서버 주소와 이미지
# AI_SERVER_URL=http://ai:8000
# AI_IMAGE=ghcr.io/42-gy/ft_cabinet_ai:latest

# ---------------------------------------------------------------
# 운영 프로파일(prod) 전용
# ---------------------------------------------------------------
# REDIS_PASSWORD=
# SCHEDULER_POOL_SIZE=5

# ---------------------------------------------------------------
# 슬랙 호출 제한 시간 (선택)
# ---------------------------------------------------------------
# SLACK_HTTP_CONNECT_TIMEOUT_MS=3000
# SLACK_HTTP_READ_TIMEOUT_MS=5000

# ---------------------------------------------------------------
# 인증 API 호출 한도 (선택, 사용자당 분당)
# ---------------------------------------------------------------
# AUTH_REISSUE_LIMIT_PER_MINUTE=20
# AUTH_LINK_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------
# 월간 대여권 지급 기준 (선택, 월 로그타임 분)
# ---------------------------------------------------------------
# LENT_TICKET_THRESHOLD_MINUTES=4800
# LENT_TICKET_TRANSCENDER_THRESHOLD_MINUTES=900

# ---------------------------------------------------------------
# 슬랙 오류제보를 관리자 DM 으로 전달 (선택)
# ---------------------------------------------------------------
# SLACK_REPORT_FORWARD_ENABLED=false
# true 로 켜면 채널 ID 가 필요하다.
# SLACK_REPORT_CHANNEL_ID=
# SLACK_REPORT_POLL_INTERVAL_MS=60000

# ---------------------------------------------------------------
# 슬랙 공지를 카카오톡으로 전달 (선택)
# ---------------------------------------------------------------
# KAKAO_NOTIFY_ENABLED=false
# 동의 정보를 암호화하는 base64 인코딩 32바이트 키. 켜려면 필수이고 잃어버리면 저장된 동의가 모두 무효가 된다.
# KAKAO_TOKEN_ENC_KEY=
# SLACK_NOTICE_FORWARD_ENABLED=false
# SLACK_NOTICE_CHANNEL_ID=
# SLACK_NOTICE_POLL_INTERVAL_MS=60000
# 카카오 메시지 링크. 비워 두면 FRONTEND_URL 을 쓴다.
# SLACK_NOTICE_LINK_URL=
# SLACK_NOTICE_PERMALINK_ENABLED=false

# ---------------------------------------------------------------
# 긴 공지 요약 (선택, Gemini)
# ---------------------------------------------------------------
# 켜면 공지 본문이 외부 API 로 전송된다.
# SLACK_NOTICE_SUMMARY_ENABLED=false
# GEMINI_API_KEY=
# SLACK_NOTICE_SUMMARY_MODEL=gemini-3.6-flash
# SLACK_NOTICE_SUMMARY_THINKING_LEVEL=low
# SLACK_NOTICE_SUMMARY_TIMEOUT=8s

# ---------------------------------------------------------------
# FAQ 챗봇 (선택)
# ---------------------------------------------------------------
# 켜려면 이미지를 CHATBOT_MODEL 빌드 인자로 빌드해 임베딩 모델을 넣어야 한다.
# CHATBOT_ENABLED=false
# CHATBOT_PERSONAL_ENABLED=false
# CHATBOT_PERSONAL_RATE_PER_MINUTE=10
# CHATBOT_MATCH_THRESHOLD=0.93
# CHATBOT_SUGGEST_THRESHOLD=0.88
# CHATBOT_MATCH_MARGIN=0.02
# CHATBOT_MATCH_ALTERNATIVES=2
# CHATBOT_EMBEDDING_PROVIDER=onnx
# CHATBOT_MODEL_ID=unknown
# CHATBOT_MODEL_DIR=/app/chatbot-model
# CHATBOT_MODEL_FILE=model.onnx
# CHATBOT_TOKENIZER_FILE=tokenizer.json
# CHATBOT_EMBEDDING_PREFIX=
# CHATBOT_MAX_TOKENS=0
# CHATBOT_EMBEDDING_THREADS=2
